# Video Perception does not load this file automatically. Export only the routes you use.

# Public transcript defaults are already auto + local-only.
VIDEO_PERCEPTION_TRANSCRIPT_PROVIDER=auto
VIDEO_PERCEPTION_TRANSCRIPT_POLICY=local-only

# Optional macOS provider host.
VIDEO_PERCEPTION_APPLE_SPEECH_BIN=

# Optional user-managed whisper.cpp route.
WHISPER_CPP_BIN=
WHISPER_CPP_MODEL=

# Optional user-managed local visual model.
VIDEO_PERCEPTION_VLM_BACKEND=ollama
VIDEO_PERCEPTION_VLM_MODEL=gemma4
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4

# Optional explicit remote route. Do not commit the value.
# VIDEO_PERCEPTION_VLM_BACKEND=gemini
# VIDEO_PERCEPTION_VLM_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=
