{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "video-perception.provider/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9][a-z0-9_-]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "locality": {
      "type": "string",
      "enum": [
        "local",
        "remote"
      ]
    },
    "media_transfer": {
      "type": "string",
      "enum": [
        "never",
        "possible",
        "required"
      ]
    },
    "runtime": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "command"
            },
            "command": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "protocol": {
              "type": "string",
              "const": "video-perception.provider-stdio/v1"
            }
          },
          "required": [
            "type",
            "command",
            "protocol"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "openai-compatible",
                "ollama-compatible"
              ]
            },
            "base_url": {
              "type": "string",
              "format": "uri"
            },
            "base_url_env": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "credential_env": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "native"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "capabilities": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "contract": {
            "type": "string",
            "minLength": 1
          },
          "modes": {
            "default": [
              "video"
            ],
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "video",
                "streaming"
              ]
            }
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "output_schema": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "contract",
          "modes"
        ],
        "additionalProperties": false
      }
    },
    "license": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "contract",
    "id",
    "version",
    "description",
    "locality",
    "media_transfer",
    "runtime",
    "capabilities"
  ],
  "additionalProperties": false
}
