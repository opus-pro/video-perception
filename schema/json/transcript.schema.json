{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "provenance": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "locality": {
          "type": "string",
          "enum": [
            "local",
            "remote"
          ]
        },
        "model": {
          "type": "string"
        },
        "timing": {
          "type": "string",
          "enum": [
            "aligned",
            "estimated",
            "unknown"
          ]
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "unavailable",
                  "failed",
                  "selected"
                ]
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "provider",
              "outcome"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "provider",
        "locality",
        "timing",
        "attempts"
      ],
      "additionalProperties": false
    },
    "language": {
      "type": "string"
    },
    "utterances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "speaker": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "start_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "end_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "text",
                "start_ms",
                "end_ms"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "text",
          "start_ms",
          "end_ms"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "language",
    "utterances"
  ],
  "additionalProperties": false
}
