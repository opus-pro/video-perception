{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "video-perception.sense-plan/v1"
    },
    "capabilities": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "policy": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "object",
            "properties": {
              "threshold": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "merge_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "merge": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "model_backend": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provider"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract",
    "capabilities"
  ],
  "additionalProperties": false
}
