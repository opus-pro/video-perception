{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bpm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "time_signature": {
      "type": "string"
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "time_ms"
        ],
        "additionalProperties": false
      }
    },
    "downbeats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "time_ms"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "bpm",
    "beats"
  ],
  "additionalProperties": false
}
