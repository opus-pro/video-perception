{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "video-perception.sample/v1"
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "modified_ns": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes",
        "modified_ns"
      ],
      "additionalProperties": false
    },
    "timeline": {
      "type": "string"
    },
    "parent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "round": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "total_frames": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "total_frame_budget": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "requested": {
      "type": "object",
      "properties": {
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "end_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_frames": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_size": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "crop": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout_seconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "start_seconds",
        "end_seconds",
        "fps",
        "max_frames",
        "max_size",
        "crop",
        "timeout_seconds"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "const": "local-ffmpeg"
        },
        "locality": {
          "type": "string",
          "const": "local"
        },
        "model": {
          "type": "null"
        },
        "filter": {
          "type": "string"
        },
        "decode_log": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "locality",
        "model",
        "filter",
        "decode_log"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "sampled",
        "partial"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "timestamp_seconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "path",
          "timestamp_seconds"
        ],
        "additionalProperties": false
      }
    },
    "sheet": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "contract",
    "source",
    "timeline",
    "parent",
    "round",
    "total_frames",
    "total_frame_budget",
    "requested",
    "provenance",
    "status",
    "warnings",
    "frames",
    "sheet",
    "elapsed_ms"
  ],
  "additionalProperties": false
}
